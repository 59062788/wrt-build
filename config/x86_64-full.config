# ============================================================================
# FanchmWrt x86_64 全功能配置片段（v3 全功能版，2026-11-23 全部包名已核）
# 基线: OpenWrt 25.12.6（分支 fanchmwrt-25.12.6）
#
# 核对来源（逐条对源码树查过，不是猜名字）:
#   * luci 应用: openwrt/luci @75a306df 的 applications/ 目录清单
#   * 后端包  : openwrt/packages @093d5516 的 recursive tree（7664 条，未截断）
#   * fwx 系列: fanchmwrt/fanchmwrt@25.12.6 的 package/fcm + fanchmwrt-packages
#
# 未加（原因见 README）: qBittorrent（feed 无包）、NFS（无 nfs-kernel-server）、
#   FileBrowser（后端不在 feed，只有 luci 壳，必然依赖失败）
# 只加后端不加 LuCI（25.12 已无对应面板）: zerotier、netdata
# ============================================================================

# ---------- 目标平台: x86 / 64 (generic) ----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

# ---------- 镜像 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
# 全功能（行为管理 + 两套代理 + Docker + AdGuard）默认 1024MB
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_KERNEL_PARTSIZE=32

# ---------- 后台本体 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-fanchmwrt=y

# ---------- FanchmWrt 行为管理（19 个面板全保留） ----------
CONFIG_PACKAGE_fwxd=y
CONFIG_PACKAGE_kmod-fwx=y
# fullconenat-nft 实际包名是 kmod-nft-fullcone
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_luci-app-fwx-resources=y
CONFIG_PACKAGE_luci-app-fwx-app-center=y
CONFIG_PACKAGE_luci-app-fwx-appfilter=y
CONFIG_PACKAGE_luci-app-fwx-dashboard=y
CONFIG_PACKAGE_luci-app-fwx-dashboard-setting=y
CONFIG_PACKAGE_luci-app-fwx-fastnat=y
CONFIG_PACKAGE_luci-app-fwx-feature=y
CONFIG_PACKAGE_luci-app-fwx-firewall=y
CONFIG_PACKAGE_luci-app-fwx-mac-blacklist=y
CONFIG_PACKAGE_luci-app-fwx-macfilter=y
CONFIG_PACKAGE_luci-app-fwx-network=y
CONFIG_PACKAGE_luci-app-fwx-record=y
CONFIG_PACKAGE_luci-app-fwx-record-whitelist=y
CONFIG_PACKAGE_luci-app-fwx-session-stat=y
CONFIG_PACKAGE_luci-app-fwx-system=y
CONFIG_PACKAGE_luci-app-fwx-traffic-stat=y
CONFIG_PACKAGE_luci-app-fwx-user=y
CONFIG_PACKAGE_luci-app-fwx-user-record=y
CONFIG_PACKAGE_luci-app-fwx-wireless=y

# ---------- 代理全家桶 ----------
CONFIG_PACKAGE_luci-app-passwall2=y       # PassWall2（xray/sing-box/hysteria 由 feed 带入）
CONFIG_PACKAGE_luci-app-openclash=y       # OpenClash（workflow 固定 commit 拉取）
CONFIG_PACKAGE_luci-app-v2raya=y          # V2RayA
CONFIG_PACKAGE_v2raya=y

# ---------- 内网穿透 / 远程接入 ----------
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_luci-app-cloudflared=y
CONFIG_PACKAGE_cloudflared=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_zerotier=y                 # 无 LuCI，用 zerotier-cli

# ---------- VPN ----------
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn=y

# ---------- 网络增强 ----------
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-mwan3=y          # 多拨 / 多线负载
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-upnp=y          # UPnP/NAT-PMP，给游戏主机、BT 用
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-wol=y           # 网络唤醒
CONFIG_PACKAGE_etherwake=y

# ---------- DNS / 去广告 ----------
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y            # 注意占用 53 端口，与 dnsmasq 二选一

# ---------- 文件共享 / 存储 ----------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-client=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_luci-app-hd-idle=y       # 硬盘休眠
CONFIG_PACKAGE_hd-idle=y

# ---------- 下载 ----------
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_luci-app-transmission=y
CONFIG_PACKAGE_transmission-daemon=y

# ---------- 容器 ----------
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y

# ---------- 监控 / 终端 ----------
CONFIG_PACKAGE_luci-app-ttyd=y          # 网页终端
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_netdata=y                # 自带 19999 网页，无 LuCI 面板

# ---------- 常用运维工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_vim=y

# ---------- SMB: ksmbd 内核版共享（v4 新增） ----------
# ksmbd-server 由 packages feed 的 net/ksmbd-tools 提供（已核实 093d5516 存在）
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y

# ---------- FileBrowser 网页文件管理（v4 新增） ----------
# 后端与 LuCI 壳均取自 kenzok8/small-package，编译前单独 sparse clone 到 package/
CONFIG_PACKAGE_filebrowser=y
CONFIG_PACKAGE_luci-app-filebrowser=y
